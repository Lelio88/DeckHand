# --- Secrets ---------------------------------------------------------------
# Les secrets vivent hors du dépôt, dans ../.deckhand-secrets/.
# Ces règles ne sont qu'un filet de sécurité supplémentaire.
*.env
!.env.example
*.key
*.pem
service-account*.json

# --- Données issues des sources externes ------------------------------------
# Le dépôt est public : aucune donnée Scryfall, TopDeck.gg ou EDHTop16 n'y entre.
# Tout ce qui suit est un artefact régénérable.
#
# Les barres obliques initiales sont IMPÉRATIVES : un motif `data/` sans ancrage
# exclurait tout dossier de ce nom à n'importe quelle profondeur — à commencer
# par la couche d'accès aux données de l'app Flutter.
/data/
/api/data/
*.bulk.json
art_hashes.bin
*.sqlite
*.db
# Tirage du banc de cadrage : des URL Scryfall et des empreintes, donc de la
# donnée de source. Régénéré par `python -m app.measure.export_framing_set`.
/app/tool/framing_set*.json
# Images du même banc, mises en cache pour ne pas retélécharger à chaque
# exécution — ce que le débit demandé par Scryfall rend nécessaire.
/app/tool/.framing_cache/
# Caches des sondes de mesure : reponses JSON des sources et illustrations
# telechargees. Ce sont des DONNEES DE SOURCE, que le SS-IV.11 interdit de
# committer sur un depot public — et 18 Mio d'illustrations Lorcana y sont
# effectivement entrees avant que cette ligne n'existe. Regeneres a la demande
# par les sondes, qui les retelechargent si le dossier est vide.
/api/.cache/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- Flutter / Dart -----------------------------------------------------------
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/ios/Pods/
app/android/.gradle/
app/android/local.properties
app/**/GeneratedPluginRegistrant.*
*.iml

# --- Outils ------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# Signature de publication Android — le dépôt est public (garde-fou §IV.7).
# Le keystore et ses mots de passe vivent dans ../.deckhand-secrets/.
app/android/key.properties
*.jks
*.keystore

# Bundles et paquets : ils sont archives dans ../.deckhand-secrets/ sous
# <projet>-v<versionCode>-<package>.aab, comme pour les autres apps du compte.
# Un AAB pese 60 Mo et se regenere ; le depot n'a pas a le porter.
*.aab
*.apk

# Traces d'inspection au navigateur (Playwright MCP) : instantanes de pages et
# journaux de console, ecrits a la racine par l'outil. Ce sont des brouillons de
# reconnaissance — ce qu'ils ont appris vit dans docs/, pas ici.
.playwright-mcp/
